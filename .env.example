# ──────────────────────────────────────────────
# Audio Downloader — Environment Configuration
# Copy to .env and fill in required values.
# ──────────────────────────────────────────────

# REQUIRED ─ API authentication token (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
API_TOKEN=CHANGE_ME_GENERATE_A_SECURE_TOKEN

# REQUIRED for HTTPS ─ Public domain name (e.g. audio.example.com)
# DOMAIN=audio.example.com

# ── Worker settings ──
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_SIZE=10

# ── Media limits ──
MAX_FILE_SIZE_MB=100
MAX_DURATION_SECONDS=1800
MAX_PLAYLIST_LENGTH=1

# ── Job lifecycle ──
JOB_TIMEOUT_SECONDS=600
ARTIFACT_TTL_SECONDS=3600
DOWNLOAD_TOKEN_TTL_SECONDS=300

# ── Storage paths (inside container) ──
OUTPUT_DIR=/data/output
TEMP_DIR=/data/tmp
DB_PATH=/data/db/jobs.db

# ── Disk monitoring ──
DISK_WARNING_PERCENT=80
DISK_REJECT_PERCENT=90

# ── Rate limiting ──
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ── Logging ──
LOG_LEVEL=INFO

# ── Server ──
HOST=0.0.0.0
PORT=8000
